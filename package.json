{
  "name": "qa-automation-portfolio-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio demo: a fictional online store, a Playwright end-to-end suite, and a dashboard that visualises the results.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=desktop-chromium",
    "test:ui": "playwright test --ui",
    "test:demo-failure": "playwright test -c playwright.demo-failure.config.ts",
    "report": "playwright show-report reports/html",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
